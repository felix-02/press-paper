RESEND_API_KEY=re_bWyRkxKb_FtrKn3PU6xS8iXHb6v7zbATV

# The "From" address on outgoing emails.
#
# IMPORTANT: With Resend's sandbox sender below, you can ONLY send to the
# email you signed up to Resend with. To email real subscribers you MUST
# verify a domain in Resend (Domains → Add Domain → add DNS records), then
# switch this to an address on that domain, e.g. "Presspaper <hello@presspaper.ai>".
FROM_EMAIL="Presspaper <onboarding@resend.dev>"

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL="hello@presspaper.ai"

# (Optional) Auto-collect signups into a Resend Audience (your mailing list).
# Create one under Resend → Audiences and paste its ID here. Leave blank to skip.
RESEND_SEGMENT_ID=
